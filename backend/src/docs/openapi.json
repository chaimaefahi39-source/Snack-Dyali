{
  "openapi": "3.0.0",
  "info": {
    "title": "Snack Dyali API",
    "version": "1.0.0",
    "description": "Documentation de l'API pour la gestion des Plats et Commandes"
  },
  "paths": {
    "/api/plats": {
      "post": {
        "summary": "Créer un nouveau plat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nom": { "type": "string", "example": "Tacos Spécial Hamid" },
                  "prix": { "type": "number", "example": 45.00 },
                  "categorie": { "type": "string", "example": "Fast Food" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Plat créé avec succès" }
        }
      }
    },
    "/api/commandes": {
      "post": {
        "summary": "Créer une nouvelle commande",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "platsSelectionnes": {
                    "type": "array",
                    "items": { "type": "integer" },
                    "example": [1]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Commande créée avec succès" }
        }
      }
    }
  }
}